<Window x:Class="LabelStudio.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="THM Label Studio Professional — Ribbon Preview 0.7" PreviewKeyDown="Window_PreviewKeyDown"
 Width="1450" Height="890" MinWidth="1024" MinHeight="640" Background="#F3F5F9" FontFamily="Segoe UI" FontSize="12">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Margin" Value="2"/><Setter Property="Padding" Value="11,5"/>
   <Setter Property="Background" Value="#F7FAFD"/><Setter Property="BorderBrush" Value="#B9C7D7"/>
   <Setter Property="BorderThickness" Value="1"/><Setter Property="MinHeight" Value="29"/>
  </Style>
  <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="MinWidth" Value="34"/><Setter Property="Padding" Value="8,5"/>
   <Setter Property="ToolTipService.ShowDuration" Value="10000"/>
  </Style>
  <Style x:Key="RibbonTab" TargetType="TabItem">
   <Setter Property="FontSize" Value="13"/><Setter Property="Padding" Value="16,8"/>
   <Setter Property="Foreground" Value="#283C56"/>
  </Style>
  <Style x:Key="RibbonButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Margin" Value="2"/><Setter Property="MinWidth" Value="70"/><Setter Property="MinHeight" Value="58"/>
   <Setter Property="Padding" Value="10,6"/><Setter Property="FontSize" Value="12"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style x:Key="RibbonGroupTitle" TargetType="TextBlock">
   <Setter Property="Foreground" Value="#64758B"/><Setter Property="FontSize" Value="10"/>
   <Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="Margin" Value="2,5,2,1"/>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Margin" Value="0,3,0,8"/><Setter Property="Padding" Value="5,4"/><Setter Property="MinHeight" Value="25"/></Style>
  <Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>
  <Style x:Key="PropertyHeading" TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#314969"/><Setter Property="Margin" Value="0,10,0,8"/></Style>
  <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="#52657C"/><Setter Property="FontSize" Value="11"/></Style>
 </Window.Resources>
 <DockPanel LastChildFill="True">
  <!-- Quick access strip remains visible across tabs -->
  <Border DockPanel.Dock="Top" Background="#20375B" Padding="9,4">
   <DockPanel>
    <TextBlock DockPanel.Dock="Left" Text="THM  |  Label Studio Professional" FontSize="13" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" Margin="7,0,15,0"/>
    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
     <Button Content="Создать" Click="New_Click" Padding="12,3" MinHeight="24"/>
     <Button Content="Открыть" Click="Open_Click" Padding="12,3" MinHeight="24"/>
     <Button Content="Сохранить" Click="Save_Click" Padding="12,3" MinHeight="24"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <TabControl DockPanel.Dock="Top" Height="138" Background="#F9FBFE" BorderBrush="#BCCBDD" BorderThickness="0,0,0,1" ItemContainerStyle="{StaticResource RibbonTab}">
   <TabItem Header="Файл"><StackPanel Orientation="Horizontal" Margin="9,5">
    <StackPanel><WrapPanel><Button Style="{StaticResource RibbonButton}" Content="▤&#10;Создать" Click="New_Click"/><Button Style="{StaticResource RibbonButton}" Content="📂&#10;Открыть" Click="Open_Click"/><Button Style="{StaticResource RibbonButton}" Content="▣&#10;Сохранить" Click="Save_Click"/></WrapPanel><TextBlock Style="{StaticResource RibbonGroupTitle}" Text="Макет"/></StackPanel>
    <Separator Margin="10,6"/>
    <StackPanel><Button Style="{StaticResource RibbonButton}" Content="▤&#10;Печать Windows" Click="Print_Click"/><TextBlock Style="{StaticResource RibbonGroupTitle}" Text="Вывод"/></StackPanel>
    <Separator Margin="10,6"/>
    <TextBlock VerticalAlignment="Center" Foreground="#64758B" Text="Печать: пока через установленный драйвер Windows. Адаптеры производителей в разработке." TextWrapping="Wrap" Width="340"/>
   </StackPanel></TabItem>
   <TabItem Header="Главная" IsSelected="True"><StackPanel Orientation="Horizontal" Margin="9,5">
    <StackPanel><WrapPanel><Button Style="{StaticResource RibbonButton}" Content="⧉&#10;Дублировать" ToolTip="Ctrl+D" Click="Duplicate_Click"/><Button Style="{StaticResource RibbonButton}" Content="✕&#10;Удалить" ToolTip="Delete" Click="Delete_Click"/></WrapPanel><TextBlock Style="{StaticResource RibbonGroupTitle}" Text="Буфер и правка"/></StackPanel>
    <Separator Margin="10,6"/>
    <StackPanel><WrapPanel>
      <Button Style="{StaticResource RibbonButton}" Content="Ж&#10;Жирный" Click="ToggleBold_Click" ToolTip="Жирное начертание для текста"/>
      <Button Style="{StaticResource RibbonButton}" Content="К&#10;Курсив" Click="ToggleItalic_Click" ToolTip="Курсивное начертание для текста"/>
      <Button Style="{StaticResource RibbonButton}" Content="Ч&#10;Подчеркнуть" Click="ToggleUnderline_Click" ToolTip="Подчеркивание текста"/>
    </WrapPanel><TextBlock Style="{StaticResource RibbonGroupTitle}" Text="Формат текста"/></StackPanel>
    <Separator Margin="10,6"/>
    <StackPanel><WrapPanel><Button Style="{StaticResource RibbonButton}" Content="↑&#10;Вперёд" Click="Front_Click"/><Button Style="{StaticResource RibbonButton}" Content="↓&#10;Назад" Click="Back_Click"/></WrapPanel><TextBlock Style="{StaticResource RibbonGroupTitle}" Text="Порядок слоёв"/></StackPanel>
    <Separator Margin="10,6"/>
    <StackPanel><TextBlock Foreground="#52657C" Margin="6,9,2,3" Text="Выдели объект на этикетке"/><TextBlock Foreground="#52657C" Margin="6,3" Text="Свойства — в панели справа"/><TextBlock Style="{StaticResource RibbonGroupTitle}" Text="Редактирование"/></StackPanel>
   </StackPanel></TabItem>
   <TabItem x:Name="ObjectFormatTab" Header="Формат объекта" IsEnabled="False"><StackPanel Orientation="Horizontal" Margin="9,5">
    <StackPanel><WrapPanel>
     <Button Style="{StaticResource RibbonButton}" Content="⟸&#10;По левому" Click="AlignLeft_Click"/>
     <Button Style="{StaticResource RibbonButton}" Content="↔&#10;По центру" Click="AlignCenter_Click"/>
     <Button Style="{StaticResource RibbonButton}" Content="⟹&#10;По правому" Click="AlignRight_Click"/>
    </WrapPanel><TextBlock Style="{StaticResource RibbonGroupTitle}" Text="Горизонтальное положение на этикетке"/></StackPanel>
    <Separator Margin="10,6"/>
    <StackPanel><WrapPanel>
     <Button Style="{StaticResource RibbonButton}" Content="↑&#10;К верху" Click="AlignTop_Click"/>
     <Button Style="{StaticResource RibbonButton}" Content="↕&#10;По середине" Click="AlignMiddle_Click"/>
     <Button Style="{StaticResource RibbonButton}" Content="↓&#10;К низу" Click="AlignBottom_Click"/>
    </WrapPanel><TextBlock Style="{StaticResource RibbonGroupTitle}" Text="Вертикальное положение на этикетке"/></StackPanel>
    <Separator Margin="10,6"/>
    <StackPanel><TextBlock Text="Перемещение: мышью" Margin="8,11,4,4" Foreground="#405778"/>
     <TextBlock Text="Размер: потяни за синий угол" Margin="8,0,4,4" Foreground="#405778"/>
     <TextBlock Text="Точные значения — в свойствах справа" Margin="8,0,4,4" Foreground="#405778"/>
     <TextBlock Style="{StaticResource RibbonGroupTitle}" Text="Работа с объектом"/></StackPanel>
   </StackPanel></TabItem>
   <TabItem Header="Вставка"><StackPanel Orientation="Horizontal" Margin="9,5">
    <StackPanel><WrapPanel><Button Style="{StaticResource RibbonButton}" Content="T&#10;Текст" Click="AddText_Click"/><Button Style="{StaticResource RibbonButton}" Content="▭&#10;Прямоугольник" Click="AddBox_Click"/><Button Style="{StaticResource RibbonButton}" Content="◯&#10;Эллипс" Click="AddEllipse_Click"/><Button Style="{StaticResource RibbonButton}" Content="╱&#10;Линия" Click="AddLine_Click"/></WrapPanel><TextBlock Style="{StaticResource RibbonGroupTitle}" Text="Графические объекты"/></StackPanel>
    <Separator Margin="10,6"/>
    <StackPanel><WrapPanel><Button Style="{StaticResource RibbonButton}" Content="▥&#10;Code 128" Click="AddCode128_Click" ToolTip="Создать штрихкод Code 128"/><Button Style="{StaticResource RibbonButton}" Content="▦&#10;QR-код" Click="AddQr_Click" ToolTip="Создать QR-код"/><Button Style="{StaticResource RibbonButton}" Content="▦&#10;Data Matrix" Click="AddDataMatrix_Click" ToolTip="Создать Data Matrix ECC200"/><Button Style="{StaticResource RibbonButton}" Content="▧&#10;Изображение" Click="AddImage_Click" ToolTip="Встроить изображение в шаблон"/></WrapPanel><TextBlock Style="{StaticResource RibbonGroupTitle}" Text="Коды и изображения"/></StackPanel>
   </StackPanel></TabItem>
   <TabItem Header="Макет"><StackPanel Orientation="Horizontal" Margin="9,5">
    <StackPanel><WrapPanel><Button Style="{StaticResource RibbonButton}" Content="↑&#10;Вперёд" Click="Front_Click"/><Button Style="{StaticResource RibbonButton}" Content="↓&#10;Назад" Click="Back_Click"/><Button Style="{StaticResource RibbonButton}" Content="⧉&#10;Копия" Click="Duplicate_Click"/></WrapPanel><TextBlock Style="{StaticResource RibbonGroupTitle}" Text="Расположение"/></StackPanel>
    <Separator Margin="10,6"/>
    <StackPanel><TextBlock Text="Размер этикетки, координаты и поворот" Margin="8,12,8,5" Foreground="#405778"/><TextBlock Text="редактируются в панели свойств справа." Margin="8,0" Foreground="#405778"/><TextBlock Style="{StaticResource RibbonGroupTitle}" Text="Параметры макета"/></StackPanel>
   </StackPanel></TabItem>
   <TabItem Header="Данные"><StackPanel Orientation="Horizontal" Margin="9,5">
    <StackPanel><Button Style="{StaticResource RibbonButton}" Content="▦&#10;Импорт CSV" Click="LoadCsv_Click"/><TextBlock Style="{StaticResource RibbonGroupTitle}" Text="Источник данных"/></StackPanel>
    <Separator Margin="10,6"/>
    <StackPanel><WrapPanel><Button Style="{StaticResource RibbonButton}" Content="◀&#10;Назад" Click="Previous_Click"/><Button Style="{StaticResource RibbonButton}" Content="▶&#10;Вперёд" Click="Next_Click"/><Button Style="{StaticResource RibbonButton}" Content="↩&#10;Шаблон" Click="ClearPreview_Click"/></WrapPanel><TextBlock Style="{StaticResource RibbonGroupTitle}" Text="Просмотр записей"/></StackPanel>
    <Separator Margin="10,6"/>
    <StackPanel><TextBlock x:Name="RowInfo" Text="0 строк" Margin="12,18,8,6" FontWeight="SemiBold" Foreground="#304A6A"/><TextBlock Style="{StaticResource RibbonGroupTitle}" Text="Загруженные данные"/></StackPanel>
   </StackPanel></TabItem>
   <TabItem Header="Печать"><StackPanel Orientation="Horizontal" Margin="9,5">
    <StackPanel><Button Style="{StaticResource RibbonButton}" Content="▤&#10;Печать Windows" Click="Print_Click"/><TextBlock Style="{StaticResource RibbonGroupTitle}" Text="Печать"/></StackPanel>
    <Separator Margin="10,6"/>
    <TextBlock Text="Специализированные RAW-модули THM, ZPL, TSPL, CAB и Godex пока не подключены." TextWrapping="Wrap" Foreground="#64758B" Width="360" VerticalAlignment="Center"/>
   </StackPanel></TabItem>
   <TabItem Header="Вид"><StackPanel Orientation="Horizontal" Margin="9,5">
    <StackPanel><WrapPanel VerticalAlignment="Center"><TextBlock Text="Масштаб" Margin="5,18,8,0" Foreground="#405778"/><ComboBox x:Name="ZoomBox" Width="93" Height="30" Margin="1,10" SelectedIndex="1" SelectionChanged="Zoom_Changed"><ComboBoxItem Content="75%"/><ComboBoxItem Content="100%"/><ComboBoxItem Content="150%"/><ComboBoxItem Content="200%"/></ComboBox></WrapPanel><TextBlock Style="{StaticResource RibbonGroupTitle}" Text="Масштаб"/></StackPanel>
    <Separator Margin="10,6"/>
    <StackPanel><CheckBox x:Name="GridCheck" Content="Показать сетку" IsChecked="True" Click="GridChanged_Click" Margin="12,14,12,9"/><CheckBox x:Name="SnapCheck" Content="Привязка 1 мм" IsChecked="True" Margin="12,0,12,1"/><TextBlock Style="{StaticResource RibbonGroupTitle}" Text="Сетка и привязка"/></StackPanel>
   </StackPanel></TabItem>
  </TabControl>
  <StatusBar DockPanel.Dock="Bottom" Background="#EFF4FA" BorderBrush="#ACC0D6" BorderThickness="0,1,0,0">
   <StatusBarItem><TextBlock x:Name="StatusText" Text="Готово · Предварительная версия · печать только через Windows"/></StatusBarItem>
   <Separator/><StatusBarItem><TextBlock Text="Единицы: мм"/></StatusBarItem>
   <Separator/><StatusBarItem><TextBlock Text="Ctrl+D — копия · Del — удалить · Ctrl+S — сохранить · синий угол — размер"/></StatusBarItem>
  </StatusBar>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="205" MinWidth="150"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*" MinWidth="330"/><ColumnDefinition Width="5"/><ColumnDefinition Width="265" MinWidth="220"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" BorderBrush="#B5C4D3" BorderThickness="0,0,1,0" Background="#F5F8FC">
    <DockPanel Margin="6">
     <Border DockPanel.Dock="Top" Background="#DDE8F5" Padding="9,8" Margin="0,0,0,5"><TextBlock Text="ОБЪЕКТЫ МАКЕТА" Foreground="#284363" FontWeight="Bold"/></Border>
     <TextBlock DockPanel.Dock="Bottom" Text="Выдели объект для настройки справа" FontSize="10" Foreground="#60748D" TextWrapping="Wrap" Margin="5,8"/>
     <ListBox x:Name="ObjectList" DisplayMemberPath="Value" SelectionChanged="ObjectList_SelectionChanged" Background="White" BorderBrush="#B9C9DA" Padding="4"/>
    </DockPanel>
   </Border>
   <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#B9C7D7" ResizeBehavior="PreviousAndNext"/>
   <Grid Grid.Column="2" Background="#B8CCE4">
    <Grid.RowDefinitions><RowDefinition Height="27"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#DBE7F5" BorderBrush="#AFC1D3" BorderThickness="0,0,0,1" Padding="9,5"><TextBlock Text="РАБОЧАЯ ОБЛАСТЬ · ЭТИКЕТКА" FontWeight="SemiBold" Foreground="#314F73"/></Border>
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#B8CCE4" CanContentScroll="False">
     <Grid MinWidth="530" MinHeight="490">
      <Border HorizontalAlignment="Center" VerticalAlignment="Center" Margin="50" Background="White" BorderBrush="#8499B0" BorderThickness="1" SnapsToDevicePixels="True">
       <Border.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.22"/></Border.Effect>
       <Canvas x:Name="EditorCanvas" Background="White" ClipToBounds="True" MouseLeftButtonDown="Canvas_MouseLeftButtonDown"/>
      </Border>
     </Grid>
    </ScrollViewer>
   </Grid>
   <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" Background="#B9C7D7" ResizeBehavior="PreviousAndNext"/>
   <Border Grid.Column="4" Background="#F5F8FC" BorderBrush="#B5C4D3" BorderThickness="1,0,0,0">
    <DockPanel Margin="6">
     <Border DockPanel.Dock="Top" Background="#DDE8F5" Padding="9,8" Margin="0,0,0,4"><TextBlock Text="СВОЙСТВА" Foreground="#284363" FontWeight="Bold"/></Border>
     <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="7,3">
       <TextBlock Text="МАКЕТ ЭТИКЕТКИ" Style="{StaticResource PropertyHeading}"/>
       <TextBlock Text="Название" Style="{StaticResource FieldLabel}"/><TextBox x:Name="NameBox" LostFocus="DocumentSettings_LostFocus"/>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0"><TextBlock Text="Ширина (мм)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="WidthBox" LostFocus="DocumentSettings_LostFocus"/></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="Высота (мм)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="HeightBox" LostFocus="DocumentSettings_LostFocus"/></StackPanel>
       </Grid>
       <Separator Margin="0,8"/>
       <TextBlock Text="ВЫДЕЛЕННЫЙ ОБЪЕКТ" Style="{StaticResource PropertyHeading}"/>
       <TextBlock Text="Выделение и изменение размеров — мышью (синий маркер)." TextWrapping="Wrap" Foreground="#506884" Margin="0,0,0,7"/>
       <StackPanel x:Name="PropertyPanel" IsEnabled="False">
        <TextBlock Text="Содержимое" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ItemValue" TextChanged="Property_Changed"/>
        <TextBlock Text="Поле CSV (для текста и штрихкодов)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ItemField" TextChanged="Property_Changed"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <StackPanel Grid.Column="0"><TextBlock Text="X (мм)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ItemX" LostFocus="Property_Changed"/></StackPanel>
         <StackPanel Grid.Column="2"><TextBlock Text="Y (мм)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ItemY" LostFocus="Property_Changed"/></StackPanel>
        </Grid>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <StackPanel Grid.Column="0"><TextBlock Text="Ширина (мм)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ItemWidth" LostFocus="Property_Changed"/></StackPanel>
         <StackPanel Grid.Column="2"><TextBlock Text="Высота (мм)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ItemHeight" LostFocus="Property_Changed"/></StackPanel>
        </Grid>
        <TextBlock Text="Размер шрифта (pt)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ItemFontSize" LostFocus="Property_Changed"/>
        <CheckBox x:Name="ItemBold" Content="Жирный текст" Margin="0,0,0,8" Checked="Property_Changed" Unchecked="Property_Changed"/>
        <CheckBox x:Name="ItemItalic" Content="Курсив" Checked="Property_Changed" Unchecked="Property_Changed"/>
        <CheckBox x:Name="ItemUnderline" Content="Подчеркнутый" Checked="Property_Changed" Unchecked="Property_Changed"/>
        <TextBlock Text="Семейство шрифта" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ItemFontFamily" LostFocus="Property_Changed"/>
        <TextBlock Text="Выравнивание текста" Style="{StaticResource FieldLabel}"/>
        <ComboBox x:Name="ItemTextAlignment" Margin="0,3,0,8" SelectionChanged="Property_Changed"><ComboBoxItem Content="Слева" Tag="Left"/><ComboBoxItem Content="По центру" Tag="Center"/><ComboBoxItem Content="Справа" Tag="Right"/></ComboBox>
        <TextBlock Text="Поворот (°)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ItemRotation" LostFocus="Property_Changed"/>
        <TextBlock Text="Толщина линии (мм)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ItemStroke" LostFocus="Property_Changed"/>
       </StackPanel>
       <Separator Margin="0,12"/>
       <TextBlock Text="ПЕЧАТЬ И УСТРОЙСТВА" Style="{StaticResource PropertyHeading}"/>
       <TextBlock Text="Доступна базовая печать через драйвер Windows." TextWrapping="Wrap" Foreground="#39536F"/>
       <TextBlock Text="Zebra · TSC · CAB · Godex · THM RAW — адаптеры пока не активны." TextWrapping="Wrap" Foreground="#9A3412" Margin="0,8,0,0"/>
      </StackPanel>
     </ScrollViewer>
    </DockPanel>
   </Border>
  </Grid>
 </DockPanel>
</Window>
