<Window x:Class="LabelStudio.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="THM Label Studio Professional — Developer Preview" Width="1320" Height="800" MinWidth="900" MinHeight="560" Background="#F3F5F9">
 <DockPanel>
  <Menu DockPanel.Dock="Top" Background="White">
   <MenuItem Header="_File"><MenuItem Header="_New" Click="New_Click"/><MenuItem Header="_Open..." Click="Open_Click"/><MenuItem Header="_Save..." Click="Save_Click"/><Separator/><MenuItem Header="Print via _Windows..." Click="Print_Click"/></MenuItem>
   <MenuItem Header="_Objects"><MenuItem Header="Add _text" Click="AddText_Click"/><MenuItem Header="Add _rectangle" Click="AddBox_Click"/><MenuItem Header="_Delete selected" Click="Delete_Click"/></MenuItem>
   <MenuItem Header="_Data"><MenuItem Header="Load _CSV..." Click="LoadCsv_Click"/><MenuItem Header="Previous row" Click="Previous_Click"/><MenuItem Header="Next row" Click="Next_Click"/><MenuItem Header="Clear preview" Click="ClearPreview_Click"/></MenuItem>
  </Menu>
  <Border DockPanel.Dock="Top" Padding="10" Background="White" BorderBrush="#E4E7ED" BorderThickness="0,0,0,1">
   <StackPanel Orientation="Horizontal">
    <Button Content="New" Width="68" Click="New_Click"/><Button Content="Open" Width="68" Margin="6,0" Click="Open_Click"/><Button Content="Save" Width="68" Click="Save_Click"/>
    <Border Width="1" Margin="12,0" Background="#D8DDE5"/>
    <Button Content="+ Text" Width="82" Click="AddText_Click"/><Button Content="+ Box" Width="82" Margin="6,0" Click="AddBox_Click"/>
    <Button Content="Delete" Width="80" Click="Delete_Click"/>
    <Border Width="1" Margin="12,0" Background="#D8DDE5"/>
    <Button Content="Import CSV" Width="100" Click="LoadCsv_Click"/><Button Content="◀" Width="36" Margin="6,0" Click="Previous_Click"/>
    <TextBlock x:Name="RowInfo" Text="No data" VerticalAlignment="Center" Margin="4,0"/><Button Content="▶" Width="36" Margin="6,0" Click="Next_Click"/>
    <Button Content="Layout" Width="75" Click="ClearPreview_Click"/>
    <Button Content="Print (Windows)..." Padding="14,6" Margin="16,0" Click="Print_Click" Background="#DCEBFC"/>
   </StackPanel>
  </Border>
  <StatusBar DockPanel.Dock="Bottom" Background="White"><StatusBarItem><TextBlock x:Name="StatusText" Text="Ready — development preview; Windows printing only"/></StatusBarItem></StatusBar>
  <Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="12" Margin="0,0,10,0">
    <DockPanel><TextBlock DockPanel.Dock="Top" Text="OBJECTS" FontWeight="Bold" Foreground="#344054" Margin="0,0,0,12"/><ListBox x:Name="ObjectList" DisplayMemberPath="Value" SelectionChanged="ObjectList_SelectionChanged"/></DockPanel>
   </Border>
   <Border Grid.Column="1" Background="#E5EAF2" CornerRadius="8" Margin="0,0,10,0">
    <Grid><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><Grid Margin="35" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Border BorderBrush="#C6CEDA" BorderThickness="1" Background="White"><Canvas x:Name="EditorCanvas" Background="White" ClipToBounds="True"/></Border>
     </Grid></ScrollViewer><TextBlock Text="WYSIWYG · dimensions in mm · drag objects to move" Margin="14,12" VerticalAlignment="Top" Foreground="#667085" IsHitTestVisible="False"/>
    </Grid>
   </Border>
   <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="14">
    <ScrollViewer><StackPanel>
     <TextBlock Text="LABEL" FontWeight="Bold" Foreground="#344054" Margin="0,0,0,10"/>
     <TextBlock Text="Name"/><TextBox x:Name="NameBox" Margin="0,4,0,8" LostFocus="DocumentSettings_LostFocus"/>
     <TextBlock Text="Width (mm)"/><TextBox x:Name="WidthBox" Margin="0,4,0,8" LostFocus="DocumentSettings_LostFocus"/>
     <TextBlock Text="Height (mm)"/><TextBox x:Name="HeightBox" Margin="0,4,0,8" LostFocus="DocumentSettings_LostFocus"/>
     <Separator Margin="0,10"/>
     <TextBlock Text="SELECTED OBJECT" FontWeight="Bold" Foreground="#344054" Margin="0,0,0,10"/>
     <StackPanel x:Name="PropertyPanel" IsEnabled="False">
      <TextBlock Text="Content"/><TextBox x:Name="ItemValue" Margin="0,4,0,8" TextChanged="Property_Changed"/>
      <TextBlock Text="CSV column (optional)"/><TextBox x:Name="ItemField" Margin="0,4,0,8" TextChanged="Property_Changed"/>
      <TextBlock Text="X (mm)"/><TextBox x:Name="ItemX" Margin="0,4,0,8" LostFocus="Property_Changed"/>
      <TextBlock Text="Y (mm)"/><TextBox x:Name="ItemY" Margin="0,4,0,8" LostFocus="Property_Changed"/>
      <TextBlock Text="Width (mm)"/><TextBox x:Name="ItemWidth" Margin="0,4,0,8" LostFocus="Property_Changed"/>
      <TextBlock Text="Height (mm)"/><TextBox x:Name="ItemHeight" Margin="0,4,0,8" LostFocus="Property_Changed"/>
      <TextBlock Text="Font size (pt)"/><TextBox x:Name="ItemFontSize" Margin="0,4,0,8" LostFocus="Property_Changed"/>
      <CheckBox x:Name="ItemBold" Content="Bold" Checked="Property_Changed" Unchecked="Property_Changed"/>
     </StackPanel>
     <Separator Margin="0,14"/>
     <TextBlock Text="PRINTER ADAPTERS" FontWeight="Bold" Foreground="#344054" Margin="0,0,0,8"/>
     <TextBlock Text="Windows graphics: basic print enabled" TextWrapping="Wrap"/>
     <TextBlock Text="Zebra / TSC / CAB / Godex / THM RAW: planned, not yet enabled" Foreground="#9A3412" TextWrapping="Wrap" Margin="0,6,0,0"/>
    </StackPanel></ScrollViewer>
   </Border>
  </Grid>
 </DockPanel>
</Window>
